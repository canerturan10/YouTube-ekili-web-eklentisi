{
  "manifest_version": 3,
  "name": "YouTube Canlı Yayın Çekiliş Botu",
  "version": "2.0",
  "description": "YouTube canlı yayın sohbetinden çekiliş yapar ve sonucu ekranda gösterir.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}